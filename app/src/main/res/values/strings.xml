    <string name="onboarding_1_text">Short, warm sentences for the person who matters to you. Say them out loud or send them in a message.</string>
    <string name="onboarding_2_title">Suggest, share, save</string>
    <string name="onboarding_2_text">Tap \"New suggestion\" for a fresh sentence. Share it in any messenger, copy it or save it as a favorite with the heart.</string>
    <string name="onboarding_3_title">Reminders and your own words</string>
    <string name="onboarding_3_text">In the settings you choose when the app reminds you. Under \"My words\" you write your own sentences. Everything stays on your device.</string>

